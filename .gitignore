# ===================================
# WebRTC Ultra-Low Latency Streaming
# Main Project .gitignore
# ===================================

# Node.js - All node_modules directories
node_modules/
*/node_modules/
**/node_modules/
backend-local/node_modules/
frontend-admin/node_modules/
frontend-viewer/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment files
.env
.env.development
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
*.log.*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
public

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.claude 
.claude/

# Windows
$RECYCLE.BIN/
Desktop.ini

# Streaming specific
# ===================

# Stream recordings
recordings/
*.mp4
*.flv
*.mkv
*.avi

# HLS segments
*.m3u8
*.ts
*.m4s

# RTMP dumps
*.dump

# Stream thumbnails
thumbnails/
*.jpg
*.png
*.gif

# FFmpeg logs
ffmpeg*.log

# Docker volumes (but keep docker-compose.yml)
streaming-docker/streams/*
!streaming-docker/streams/.gitkeep

# Build artifacts - All build directories
build/
*/build/
**/build/
dist/
*/dist/
**/dist/
out/
*/out/
**/out/

# Development files
*.dev
*.local
*.test

# Backup files
*.bak
*.backup
*.old
*.orig

# Lock files - Not committing to avoid conflicts
package-lock.json
*/package-lock.json
**/package-lock.json
yarn.lock
*/yarn.lock
**/yarn.lock

# IDE/Editor specific
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
*.code-workspace

# MacOS
.AppleDouble
.LSOverride
Icon?

# Linux
*~
.nfs*

# WebRTC specific
# ================
# STUN/TURN server configs (if they contain secrets)
# stun-config.json
# turn-config.json

# SSL certificates (never commit these)
*.pem
*.key
*.crt
*.p12
*.pfx
ssl/

# Stats and monitoring
stats/
metrics/
monitoring/

# Test files
test-recordings/
test-streams/