# ========================================
# Frontend Admin - React/Vite .gitignore
# ========================================

# Dependencies
node_modules/
*/node_modules/
**/node_modules/
.pnp
.pnp.js


# Production builds
/dist
/build
/.svelte-kit

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db

# Vite specific
# Hot reload
.vite/

# Build artifacts
dist-ssr
*.local

# Testing
coverage/

# Cache
.cache/
.parcel-cache/

# Temporary files
tmp/
temp/

# WebRTC Streaming Frontend Specific
# ===================================

# Stream preview images
preview/
thumbnails/
*.jpg
*.png
*.gif
*.webp

# User recordings (client-side)
downloads/
exports/
recordings/

# WebRTC debug files
webrtc-debug.log
ice-candidates.log
signaling-debug.log

# Media files
media/
assets/videos/
assets/audio/
*.mp4
*.webm
*.ogg
*.wav
*.mp3

# Configuration overrides
config.local.js
config.override.js

# Stats exports
stats-export/
analytics-export/

# Backup configurations
*.backup
*.bak