{
  "name": "webrtc-streaming-system",
  "version": "1.0.0",
  "description": "Ultra-Low Latency WebRTC Streaming System with Dynamic Environment Management",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev.js", 
    "dev:bat": "scripts\\start-dev.bat",
    "stop:dev": "node scripts/stop-dev.js",
    "stop:dev:bat": "scripts\\stop-dev.bat",
    "prod": "node scripts/start-prod.js",
    "prod:bat": "scripts\\start-prod.bat",
    "stop:prod": "node scripts/stop-prod.js",
    "stop:prod:bat": "scripts\\stop-prod.bat",
    "ip": "node scripts/detect-ip.js",
    "ip:bat": "scripts\\detect-local-ip.bat",
